# Voice Call Dashboard — web-server hardening.
#
# There was no .htaccess in this project at all. The production host happens to block dotfiles
# already (a request for /voicecall/.env returns 403), but that is the host's configuration, not
# this app's — a move to another server, or a config change, would silently expose .env with the
# ERP database password, the OpenRouter key and the Google OAuth secret in it. These rules make the
# protection travel with the code.

# Directory listings: api/storage/ holds cached call audio, migrations/ the schema.
Options -Indexes

# --- Dotfiles: .env, .env.example, .git/, .gitignore ---
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --- Files that are part of the repo but must never be served ---
# .sql  — migrations, i.e. the full schema
# .md   — DEPLOY.md and "MCP SQL SERVER.md" document hosts, credentials layout and internals
# .xlsx — business data checked in alongside the code
# .log / .bak / .example — logs and config templates
<FilesMatch "\.(sql|md|xlsx|log|bak|example)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Project spec: describes the internal architecture in detail. Note this is deliberately narrower
# than "*.json" — index.html's "Local" data source fetches 20260120-20260131/recordings.json.
<Files "AI_voice.json">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"

    # 'unsafe-inline' is unavoidable for now — index.html is one file of inline <script> and style
    # attributes — so this is not a complete XSS defence. It still earns its place: an injected
    # payload cannot pull in a remote script or exfiltrate transcripts to a host that isn't listed
    # here. The four hosts are the ones the frontend actually uses (lucide icons from unpkg, Google
    # Drive + OAuth). Tightening this to a nonce-based policy means moving the inline scripts out
    # to .js files first.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://accounts.google.com https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' https://www.googleapis.com https://accounts.google.com https://oauth2.googleapis.com; frame-src https://accounts.google.com https://drive.google.com; object-src 'none'; base-uri 'self'; form-action 'self'"
</IfModule>
