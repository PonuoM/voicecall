# Copy to .env (gitignored) and fill in real values.

# Local voicecall_ai DB (AI pipeline output)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=voicecall_ai
DB_USER=root
DB_PASS=your_local_mysql_password

# Remote primacom_mini_erp DB — READ ONLY (customers/users/companies lookup)
# Host/user are deliberately placeholders: this file is committed and was being served publicly,
# so it must not name real infrastructure. Real values live in .env only.
ERP_DB_HOST=your_erp_db_host
ERP_DB_PORT=3306
ERP_DB_NAME=primacom_mini_erp
ERP_DB_USER=your_erp_db_user
ERP_DB_PASS=your_erp_db_password

# AI provider — OpenRouter for everything (chat, STT, embeddings). Single key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_COMPLIANCE_MODEL=google/gemini-2.5-flash
OPENROUTER_STT_MODEL=google/gemini-2.5-flash
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Google Drive. audio_proxy.php has no fallback — unset means recordings simply won't load.
GDRIVE_API_KEY=your_google_api_key
GDRIVE_ROOT_FOLDER_ID=your_drive_root_folder_id
CRON_HTTP_KEY=YOUR_RANDOM_TOKEN

# ---- Per-capability endpoints (OpenRouterClient::endpoint) ----
# Chat, speech-to-text and embeddings each resolve their own provider. Anything left unset falls
# back to the OPENROUTER_* values above, so a host that configures none of this keeps working and
# the three can be migrated one at a time.

# Analysis. MiniMax's OpenAI-compatible endpoint — no GroupId, unlike the api.minimaxi.com one.
# M3 is a reasoning model and its thinking is billed against max_tokens: the per-company max_tokens
# in ai_prompts must be raised well past what flash-lite needed, or it thinks and never answers.
#LLM_BASE_URL=https://api.minimax.io/v1
#LLM_API_KEY=
#LLM_MODEL=MiniMax-M3

# Transcription. Points at the self-hosted Typhoon service in asr-service/, which is bound to
# loopback — reach it over an SSH tunnel or put TLS in front before using a non-local address.
#STT_BASE_URL=http://127.0.0.1:8000/v1
#STT_API_KEY=
#STT_MODEL=scb10x/typhoon-asr-realtime

# Embeddings deliberately have no override here: they cost almost nothing, and MiniMax's embo-01
# speaks a different request shape, so they stay on OpenRouter.
#EMBEDDING_BASE_URL=
#EMBEDDING_API_KEY=
#EMBEDDING_MODEL=
