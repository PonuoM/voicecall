# Copy to .env (gitignored) and fill in real values.

# Local voicecall_ai DB (AI pipeline output)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=voicecall_ai
DB_USER=root
DB_PASS=your_local_mysql_password

# Remote primacom_mini_erp DB — READ ONLY (customers/users/companies lookup)
ERP_DB_HOST=202.183.192.218
ERP_DB_PORT=3306
ERP_DB_NAME=primacom_mini_erp
ERP_DB_USER=primacom_bloguser
ERP_DB_PASS=your_erp_db_password

# AI provider — OpenRouter for everything (chat, STT, embeddings). Single key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_COMPLIANCE_MODEL=google/gemini-2.5-flash
OPENROUTER_STT_MODEL=google/gemini-2.5-flash
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

